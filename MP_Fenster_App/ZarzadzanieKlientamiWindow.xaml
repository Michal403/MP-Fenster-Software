<Window x:Class="MP_Fenster_App.ZarzadzanieKlientamiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="SeaShark - Panel Kontrahentów" Height="500" Width="850"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid Margin="15">
        <TabControl x:Name="TabKlient">
            <TabItem Header="🔍 Wybierz Kontrahenta" x:Name="TabLista">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Szukaj klienta: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtSzukaj" Width="250" Margin="10,0" VerticalContentAlignment="Center" TextChanged="TxtSzukaj_TextChanged"/>
                        <TextBlock Text="* Kliknij dwukrotnie wiersz, aby zatwierdzić wybór" Foreground="#7F8C8D" FontStyle="Italic" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="DgKlienci" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="All" AlternatingRowBackground="#F9F9F9"
                              MouseDoubleClick="DgKlienci_MouseDoubleClick" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdKlienta}" Width="50"/>
                            <DataGridTextColumn Header="Nazwa Firmy / Imię i Nazwisko" Binding="{Binding NazwaKlienta}" Width="250" FontWeight="Bold"/>
                            <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" Width="120"/>
                            <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="200"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Zatwierdź wybór" Width="140" Height="30" Background="#2980B9" Foreground="White" FontWeight="Bold" Click="BtnWybierz_Click"/>
                        <Button Content="Anuluj" Width="100" Height="30" Margin="10,0,0,0" Background="#95A5A6" Foreground="White" Click="BtnAnuluj_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="➕ Dodaj Nowego Kontrahenta" x:Name="TabNowy">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa / Klient:" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormNazwa" Grid.Row="0" Grid.Column="1" Margin="5" Padding="3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="NIP (opcjonalnie):" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormNIP" Grid.Row="1" Grid.Column="1" Margin="5" Padding="3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Adres:" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormAdres" Grid.Row="2" Grid.Column="1" Margin="5" Padding="3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefon:" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormTelefon" Grid.Row="3" Grid.Column="1" Margin="5" Padding="3"/>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="💾 Zapisz i wybierz" Width="160" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="BtnZapisz_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
