<Window x:Class="MP_Fenster_App.HandlowiecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#E0E0E0">

    <Window.Resources>
        <!-- Styl dla dużych kolorowych kafelków -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu górne -->
            <RowDefinition Height="*"/>
            <!-- Główna zawartość -->
            <RowDefinition Height="30"/>
            <!-- Pasek statusu -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <!-- Niebieski pasek boczny -->
            <ColumnDefinition Width="200"/>
            <!-- Drzewo zleceń -->
            <ColumnDefinition Width="*"/>
            <!-- Panel główny -->
        </Grid.ColumnDefinitions>

        <!-- MENU GÓRNE -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#F0F0F0" Padding="5">
            <MenuItem Header="Strona startowa"/>
            <MenuItem Header="Opcje"/>
            <MenuItem Header="Drukuj"/>
            <MenuItem Header="Portal internetowy"/>
            <MenuItem Header="Pomoc"/>
            <MenuItem Header="Koniec" Click="BtnLogout_Click"/>
        </Menu>

        <!-- NIEBIESKI PIONOWY PASEK (Z tekstem) -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E88E5">
            <TextBlock Text="M+P  FENSTER  SOFTWARE  2026" Foreground="White" 
                       FontWeight="Bold" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <!-- LISTA / DRZEWO ZLECEŃ -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Ostatnie zlecenia" FontWeight="Bold" Margin="0,0,0,10"/>
                <TreeView BorderThickness="0">
                    <TreeViewItem Header="Zlecenia" IsExpanded="True">
                        <TreeViewItem Header="Zlecenie 45689"/>
                        <TreeViewItem Header="Zlecenie 45690"/>
                        <TreeViewItem Header="Zlecenie 45720"/>
                        <TreeViewItem Header="Zlecenie 45725"/>
                        <TreeViewItem Header="Zlecenie 45726"/>
                    </TreeViewItem>
                </TreeView>
            </StackPanel>
        </Border>

        <!-- PANEL GŁÓWNY Z KAFELKAMI -->
        <Border Grid.Row="1" Grid.Column="2" Background="#90AFC5" Margin="20" 
                CornerRadius="10" BorderBrush="Black" BorderThickness="1">
            <UniformGrid Columns="2" Rows="2" Margin="50">

                <!-- Nowe zlecenie -->
                <Button Style="{StaticResource TileButtonStyle}" Background="#90EE90" x:Name="BtnNowe">
                    <StackPanel>
                        <TextBlock Text="✎" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nowe zlecenie" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Przegląd zleceń -->
                <Button Style="{StaticResource TileButtonStyle}" Background="#FFD39B" x:Name="BtnPrzeglad">
                    <StackPanel>
                        <TextBlock Text="田" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="Przegląd zleceń" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Status zleceń -->
                <Button Style="{StaticResource TileButtonStyle}" Background="#FF7F7F" x:Name="BtnStatus">
                    <StackPanel>
                        <TextBlock Text="📁" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="Status zleceń" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Baza Klientów -->
                <Button Style="{StaticResource TileButtonStyle}" Background="#B39DDB" x:Name="BtnKlienci">
                    <StackPanel>
                        <TextBlock Text="👤👤" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="Baza Klientów" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </Border>

        <!-- PASEK STATUSU -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#D3D3D3">
            <StatusBarItem Content="16.04.2026"/>
            <Separator/>
            <StatusBarItem Content="J.KOWALSKI" HorizontalAlignment="Right"/>
            <Separator/>
            <StatusBarItem Content="14:53"/>
        </StatusBar>
    </Grid>
</Window>