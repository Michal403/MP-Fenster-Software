<Window x:Class="MP_Fenster_App.HandlowiecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#E0E0E0">

    <Window.Resources>
        <!-- Styl dla kolorowych kafelków -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="Black" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- 0: Menu -->
            <RowDefinition Height="*"/>
            <!-- 1: Treść -->
            <RowDefinition Height="30"/>
            <!-- 2: Status -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <!-- 0: Pasek pionowy -->
            <ColumnDefinition Width="220"/>
            <!-- 1: Drzewo zleceń -->
            <ColumnDefinition Width="*"/>
            <!-- 2: Kafelki -->
        </Grid.ColumnDefinitions>

        <!-- MENU GÓRNE -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#F0F0F0">
            <MenuItem Header="Strona startowa"/>
            <MenuItem Header="Opcje"/>
            <MenuItem Header="Drukuj"/>
            <MenuItem Header="Pomoc"/>
            <MenuItem Header="Koniec" Click="BtnLogout_Click"/>
        </Menu>

        <!-- NIEBIESKI PASEK BOCZNY -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E88E5">
            <TextBlock Text="M+P  FENSTER  SOFTWARE  2026" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <!-- DRZEWO ZLECEŃ -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Ostatnie zlecenia" FontWeight="Bold" Margin="0,0,0,10"/>
                <TreeView x:Name="MyOrdersTree" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- KAFELKI -->
        <Border Grid.Row="1" Grid.Column="2" Background="#90AFC5" Margin="15" CornerRadius="10" BorderBrush="Black" BorderThickness="1">
            <UniformGrid Columns="2" Rows="2" Margin="30">
                <Button Style="{StaticResource TileButtonStyle}" Background="#90EE90" Click="BtnNowe_Click">
                    <StackPanel>
                        <TextBlock Text="✎" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nowe zlecenie" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#FFD39B" Click="BtnPrzeglad_Click">
                    <StackPanel>
                        <TextBlock Text="田" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Przegląd zleceń" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#FF7F7F" Click="BtnStatus_Click">
                    <StackPanel>
                        <TextBlock Text="📁" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Status zleceń" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#B39DDB" Click="BtnKlienci_Click">
                    <StackPanel>
                        <TextBlock Text="👤👤" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Baza Klientów" FontSize="18"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <!-- PASEK STATUSU -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#D3D3D3">
            <StatusBarItem x:Name="StatusDate" Content="DATA"/>
            <Separator/>
            <StatusBarItem x:Name="StatusUser" Content="LOGIN"/>
            <Separator/>
            <StatusBarItem x:Name="StatusTime" Content="GODZINA" HorizontalAlignment="Right"/>
        </StatusBar>
    </Grid>
</Window>