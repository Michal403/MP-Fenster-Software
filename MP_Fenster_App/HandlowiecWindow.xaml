<Window x:Class="MP_Fenster_App.HandlowiecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0 - Pulpit Handlowca" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#E0E0E0"
        Icon="/Ikony/logo.png">

    <Window.Resources>
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="Black" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#F0F0F0">
            <MenuItem Header="Strona startowa" Click="MenuStart_Click"/>
            <MenuItem Header="Opcje" Click="MenuOpcje_Click"/>
            <MenuItem Header="Drukuj" Click="MenuDrukuj_Click"/>
            <MenuItem Header="Pomoc" Click="MenuPomoc_Click"/>
            <MenuItem Header="Koniec" Click="BtnLogout_Click"/>
        </Menu>

        <Border Grid.Row="1" Grid.Column="0" Background="#1E88E5">
            <TextBlock Text="M+P  FENSTER  SOFTWARE  2026" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Ostatnie oferty i zlecenia" FontWeight="Bold" Margin="0,0,0,10"/>
                <TreeView x:Name="MyOrdersTree" BorderThickness="0" MouseDoubleClick="MyOrdersTree_MouseDoubleClick"/>
                <TextBlock Text="Dwuklik otwiera ofertę, jeśli można ją jeszcze edytować." TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="#90AFC5" Margin="15" CornerRadius="10" BorderBrush="Black" BorderThickness="1">
            <UniformGrid Columns="2" Rows="2" Margin="30">
                <Button Style="{StaticResource TileButtonStyle}" Background="#90EE90" Click="BtnNowe_Click">
                    <StackPanel>
                        <Image Source="/Ikony/Pulpit/nowa_oferta.png" Width="72" Height="72" HorizontalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text="Nowa oferta" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#FFD39B" Click="BtnPrzeglad_Click">
                    <StackPanel>
                        <Image Source="/Ikony/Pulpit/przeglad_ofert.png" Width="72" Height="72" HorizontalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text="Przegląd ofert" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#FF7F7F" Click="BtnStatus_Click">
                    <StackPanel>
                        <Image Source="/Ikony/Pulpit/status_zlecen.png" Width="72" Height="72" HorizontalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text="Status zleceń" FontSize="18"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButtonStyle}" Background="#B39DDB" Click="BtnKlienci_Click">
                    <StackPanel>
                        <Image Source="/Ikony/Pulpit/baza_klientow.png" Width="72" Height="72" HorizontalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text="Baza klientów" FontSize="18"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#D3D3D3">
            <StatusBarItem x:Name="StatusDate" Content="DATA"/>
            <Separator/>
            <StatusBarItem x:Name="StatusUser" Content="LOGIN"/>
            <Separator/>
            <StatusBarItem x:Name="StatusTime" Content="GODZINA" HorizontalAlignment="Right"/>
        </StatusBar>
    </Grid>
</Window>



