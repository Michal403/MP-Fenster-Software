<Window x:Class="MP_Fenster_App.StatusZlecenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0 - Monitor i Status Zleceń" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E1E1E1" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Zalogowany pracownik: " FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock x:Name="TxtPracownikInfo" Text="BRAK" Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" Margin="0,0,20,0"/>

                    <TextBlock Text="Rola systemowa: " FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                    <Border x:Name="BrdrRola" Background="#007ACC" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRolaInfo" Text="POBIERANIE..." Foreground="White" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOdswiez" Content="🔄 Odśwież Bazę" Padding="8,4" FontWeight="Bold" Margin="5,0" Click="BtnOdswiez_Click"/>
                    <Button x:Name="BtnSzczegolyZlecenia" Content="👁️ Otwórz Kreator" Padding="8,4" Margin="5,0" Click="BtnSzczegolyZlecenia_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Header=" Rejestr Zamówień i Ofert Handlowych (Baza Docker)" Margin="5" FontWeight="Bold" Foreground="#333333">
            <DataGrid x:Name="GridZlecenia" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" GridLinesVisibility="All" Background="White"
                      AlternatingRowBackground="#FDFDFD" SelectionChanged="GridZlecenia_SelectionChanged" FontWeight="Normal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID bazy" Binding="{Binding IdZlecenia}" Width="60" />
                    <DataGridTextColumn Header="Numer oferty" Binding="{Binding NumerZlecenia}" Width="100" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Kontrahent / Klient" Binding="{Binding NazwaKlienta}" Width="250"/>
                    <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" Width="110"/>
                    <DataGridTextColumn Header="Wprowadził" Binding="{Binding LoginUzytkownika}" Width="110"/>
                    <DataGridTextColumn Header="Data wpływu" Binding="{Binding DataWprowadzenia, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="Termin realizacji" Binding="{Binding TerminPreferowany, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="Obszar handlowy" Binding="{Binding Obszar}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusZlecenia}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="OFERTA">
                                        <Setter Property="Foreground" Value="DarkCyan"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

        <GroupBox Grid.Row="3" Header=" Składniki Wybranego Zlecenia (PozycjeZlecenia)" Margin="5" FontWeight="Bold" Foreground="#333333">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="GridPozycjeZlecenia" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="All" Background="White" AlternatingRowBackground="#FAFAFA" FontWeight="Normal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Poz." Binding="{Binding IdPozycji}" Width="60"/>
                        <DataGridTextColumn Header="Typ ramy" Binding="{Binding NrProdukcyjny}" Width="90" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Ilość (szt)" Binding="{Binding Sztuk}" Width="75"/>
                        <DataGridTextColumn Header="Szerokość" Binding="{Binding Szerokosc}" Width="85"/>
                        <DataGridTextColumn Header="Wysokość" Binding="{Binding Wysokosc}" Width="85"/>
                        <DataGridTextColumn Header="Cena jedn. netto" Binding="{Binding CenaJednostkowa, StringFormat=\{0:N2\} PLN}" Width="130"/>
                        <DataGridTextColumn Header="Status tech." Binding="{Binding StatusTechniczny}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" BorderBrush="#EFEFEF" BorderThickness="1,0,0,0" Padding="10" Background="#FAFAFA">
                    <StackPanel>
                        <TextBlock Text="Specyfikacja i uwagi do konstrukcji:" FontSize="12" FontWeight="Bold" Margin="0,0,0,5" Foreground="#555555"/>
                        <TextBox x:Name="TxtUwagiPozycji" Height="150" TextWrapping="Wrap" IsReadOnly="True" Background="#FFFFFF" BorderBrush="#CCCCCC" FontSize="11" FontWeight="Normal" Padding="5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="4" Background="#E5E5E5">
            <StatusBarItem>
                <TextBlock Text="System statusów zsynchronizowany z Dockerem Engine 2026." FontSize="11" Foreground="#666666"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>