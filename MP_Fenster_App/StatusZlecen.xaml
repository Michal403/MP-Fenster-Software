<Window x:Class="MP_Fenster_App.StatusZlecen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0 - Panel Statusu i Przeglądu Zleceń" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="PRZEGLĄD I HISTORIA ZLECEŃ SYSTEMOWYCH" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                <Grid Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zalogowany operator: " Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtOperator" Text="MICHAL" FontWeight="Bold" Foreground="#34495E" FontSize="12"/>
                        <TextBlock Text=" | Rola systemowa: " Margin="10,0,0,0" Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtRola" Text="TECHNOLOG" FontWeight="Bold" Foreground="#27AE60" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="* Kliknij dwukrotnie wiersz, aby edytować zlecenie" HorizontalAlignment="Right" Foreground="#95A5A6" FontStyle="Italic" FontSize="11"/>
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridZlecenia" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" Background="White" 
                  BorderBrush="#CCCCCC" AlternatingRowBackground="#F9F9F9" RowHeaderWidth="0"
                  MouseDoubleClick="GridZlecenia_MouseDoubleClick" FontSize="12" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Bazy" Width="60" Binding="{Binding IdZlecenia}"/>
                <DataGridTextColumn Header="Numer Zlecenia" Width="110" Binding="{Binding NumerZlecenia}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Kontrahent / Firma" Width="250" Binding="{Binding NazwaKlienta}"/>
                <DataGridTextColumn Header="Wprowadził (Handlowiec)" Width="150" Binding="{Binding Wprowadzil}"/>
                <DataGridTextColumn Header="Data Wprowadzenia" Width="140" Binding="{Binding DataWprowadzenia, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
                <DataGridTextColumn Header="Obszar" Width="90" Binding="{Binding Obszar}"/>
                <DataGridTextColumn Header="Status Dokumentu" Width="*" Binding="{Binding StatusZlecenia}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="OFERTA">
                                    <Setter Property="Foreground" Value="Blue"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Wymaga Akceptacji">
                                    <Setter Property="Foreground" Value="Red"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Zaakceptowane">
                                    <Setter Property="Foreground" Value="Green"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Odśwież listę bazy" Width="140" Height="30" Margin="5,0" Background="#FFFFFFFF" Click="BtnOdswiez_Click"/>
            <Button Content="Otwórz w konfiguratorze" Width="180" Height="30" Margin="5,0" Background="#2980B9" Foreground="White" FontWeight="Bold" Click="BtnOtworz_Click"/>
            <Button Content="Zamknij panel" Width="100" Height="30" Margin="5,0" Background="#E74C3C" Foreground="White" Click="BtnAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>