<Window x:Class="MP_Fenster_App.StatusZlecen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="FENSTER 1.0 - Rejestr ofert i zleceń" Height="650" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtNaglowek" Text="PRZEGLĄD OFERT" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                <Grid Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zalogowany operator: " Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtOperator" Text="MICHAL" FontWeight="Bold" Foreground="#34495E" FontSize="12"/>
                        <TextBlock Text=" | Rola systemowa: " Margin="10,0,0,0" Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="TxtRola" Text="TECHNOLOG" FontWeight="Bold" Foreground="#27AE60" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPodpowiedz" Text="Dwuklik otwiera wybraną ofertę." HorizontalAlignment="Right" Foreground="#95A5A6" FontStyle="Italic" FontSize="11"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Szukaj" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSzukaj" Grid.Column="1" Height="24" TextChanged="TxtSzukaj_TextChanged"/>
                <Button Grid.Column="2" Content="Odśwież" Width="90" Height="26" Margin="8,0,0,0" Click="BtnOdswiez_Click"/>
                <TextBlock x:Name="TxtInfoTrybu" Grid.Column="3" Text="" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#666666"/>
            </Grid>
        </Border>

        <DataGrid x:Name="GridZlecenia" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" Background="White"
                  BorderBrush="#CCCCCC" AlternatingRowBackground="#F9F9F9" RowHeaderWidth="0"
                  MouseDoubleClick="GridZlecenia_MouseDoubleClick" FontSize="12" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusTechniczny}" Value="WYMAGA AKCEPTACJI">
                            <Setter Property="Background" Value="#FFFFE1E1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusTechniczny}" Value="ZAAKCEPTOWANO ODSTĘPSTWO">
                            <Setter Property="Background" Value="#FFE7F6E7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="55" Binding="{Binding IdZlecenia}"/>
                <DataGridTextColumn Header="Numer" Width="90" Binding="{Binding NumerZlecenia}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Kontrahent / Firma" Width="230" Binding="{Binding NazwaKlienta}"/>
                <DataGridTextColumn Header="Handlowiec" Width="120" Binding="{Binding Wprowadzil}"/>
                <DataGridTextColumn Header="Data" Width="135" Binding="{Binding DataWprowadzenia, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
                <DataGridTextColumn Header="Obszar" Width="80" Binding="{Binding Obszar}"/>
                <DataGridTextColumn Header="Dokument" Width="95" Binding="{Binding StatusZlecenia}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="OFERTA">
                                    <Setter Property="Foreground" Value="Blue"/>
                                </Trigger>
                                <Trigger Property="Text" Value="ZLECENIE">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Techniczne" Width="170" Binding="{Binding StatusTechniczny}"/>
                <DataGridTextColumn Header="Produkcja" Width="170" Binding="{Binding StatusProdukcji}"/>
                <DataGridTextColumn Header="Zaksięgowano" Width="130" Binding="{Binding DataZaksiegowania, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LblStatusProdukcji" Text="Status produkcji" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbStatusProdukcji" Width="220" Height="28" DisplayMemberPath="NazwaStatusu" SelectedValuePath="NazwaStatusu"/>
                <Button x:Name="BtnZmienStatusProdukcji" Content="Zmień status" Width="120" Height="30" Margin="8,0,0,0" Click="BtnZmienStatusProdukcji_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnKsiegowanie" Content="Zaksięguj ofertę na zlecenie" Width="190" Height="30" Margin="5,0" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="BtnKsiegowanie_Click"/>
                <Button x:Name="BtnCofnij" Content="Cofnij do oferty" Width="130" Height="30" Margin="5,0" Background="#F9A825" Click="BtnCofnij_Click"/>
                <Button Content="Zamknij panel" Width="110" Height="30" Margin="5,0" Background="#E74C3C" Foreground="White" Click="BtnAnuluj_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


