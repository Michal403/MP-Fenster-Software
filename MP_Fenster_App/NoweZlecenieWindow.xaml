<Window x:Class="MP_Fenster_App.NoweZlecenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kreator Zlecenia - FENSTER 1.0" Height="850" Width="1300"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu i Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Nagłówek zlecenia -->
            <RowDefinition Height="*"/>
            <!-- Główna treść -->
            <RowDefinition Height="40"/>
            <!-- Stopka -->
        </Grid.RowDefinitions>

        <!-- 1. TOOLBAR (Ikony operacji) -->
        <StackPanel Grid.Row="0">
            <Menu Background="White">
                <MenuItem Header="Zlecenie"/>
                <MenuItem Header="Pozycja"/>
                <MenuItem Header="Ceny"/>
                <MenuItem Header="Widok"/>
            </Menu>
            <ToolBarTray>
                <ToolBar Background="#E5E5E5">
                    <Button Content="💾 Zapisz" Margin="2" Click="BtnZapisz_Click"/>
                    <Separator/>
                    <Button Content="🖨 Drukuj" Margin="2"/>
                    <Button Content="➕ Nowa poz." Margin="2"/>
                    <Button Content="❌ Usuń" Margin="2"/>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <!-- 2. NAGŁÓWEK (Dane ogólne - przygotowane pod SQL) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Zlecenie:" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBox x:Name="TxtNrZlecenia" Text="45726" IsReadOnly="True" Grid.Column="1" Margin="5"/>

                <Label Content="Klient:" VerticalAlignment="Center" Grid.Column="2" Margin="10,0,0,0"/>
                <TextBox x:Name="TxtKlient" Text="Nowak Mateusz" Grid.Column="3" Margin="5"/>

                <Label Content="Termin:" VerticalAlignment="Center" Grid.Column="4" Margin="10,0,0,0"/>
                <DatePicker Grid.Column="5" Margin="5"/>

                <StackPanel Orientation="Horizontal" Grid.Column="6" HorizontalAlignment="Right">
                    <CheckBox Content="Transport" VerticalAlignment="Center" Margin="5" IsChecked="True"/>
                    <CheckBox Content="Montaż" VerticalAlignment="Center" Margin="5" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. GŁÓWNY PANEL (3 Kolumny) -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <!-- Lewo: Atrybuty -->
                <ColumnDefinition Width="*"/>
                <!-- Środek: Rysunek -->
                <ColumnDefinition Width="350"/>
                <!-- Prawo: Pozycje i Sumy -->
            </Grid.ColumnDefinitions>

            <!-- LEWA: Tabela Atrybutów (To będą dane z bazy Azure) -->
            <GroupBox Header="Parametry techniczne" Grid.Column="0">
                <DataGrid x:Name="GridAtrybuty" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Atrybut" Binding="{Binding Nazwa}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Wartość" Binding="{Binding Wartosc}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- ŚRODEK: Rysunek i Detale -->
            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Rysunek okna -->
                    <RowDefinition Height="200"/>
                    <!-- Opis tekstowy -->
                </Grid.RowDefinitions>

                <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Tu docelowo będzie Twój szkic okna -->
                        <TextBlock Text="[ SZKIC TECHNICZNY OKNA ]" FontSize="24" Foreground="#CCCCCC"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="Opis jednostki" Grid.Row="1">
                    <ScrollViewer>
                        <TextBlock x:Name="TxtOpisJednostki" TextWrapping="Wrap" Margin="5" Text="System: Schuco Focusing MD, Wymiar: 1000 x 1000, Kolor: Biały..."/>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- PRAWA: Pozycje i Sumy -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Lista pozycji -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tabela sum -->
                </Grid.RowDefinitions>

                <GroupBox Header="Lista pozycji">
                    <DataGrid x:Name="GridPozycje" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poz." Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Produkt" Binding="{Binding Kod}" Width="*"/>
                            <DataGridTextColumn Header="Szt." Binding="{Binding Ilosc}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Podsumowanie kosztów" Grid.Row="1" Margin="0,5,0,0">
                    <StackPanel Background="#EFEFEF" Margin="5">
                        <Grid Margin="2">
                            <TextBlock Text="Cena całkowita:"/>
                            <TextBlock x:Name="LblCenaSuma" Text="12 100,00 PLN" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="2">
                            <TextBlock Text="Rabat:"/>
                            <TextBlock Text="12%" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator/>
                        <Grid Margin="2">
                            <TextBlock Text="DO ZAPŁATY:" FontSize="16" FontWeight="Bold" Foreground="Red"/>
                            <TextBlock x:Name="LblCenaFinal" Text="14 898,00 PLN" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="Red"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 4. STOPKA -->
        <StatusBar Grid.Row="3" Background="#D3D3D3">
            <StatusBarItem x:Name="StatusUser" Content="Użytkownik: MICHAŁ"/>
            <Separator/>
            <StatusBarItem x:Name="StatusInfo" Content="Status: Tworzenie nowego zlecenia"/>
        </StatusBar>
    </Grid>
</Window>