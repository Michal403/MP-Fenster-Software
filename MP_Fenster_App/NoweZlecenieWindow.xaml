<Window x:Class="MP_Fenster_App.NoweZlecenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0 - Kreator Zlecenia" Height="768" Width="1024" 
        WindowState="Maximized" Background="#F0F0F0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Ikony -->
            <RowDefinition Height="Auto"/>
            <!-- Nagłówek -->
            <RowDefinition Height="*"/>
            <!-- Główna zawartość -->
            <RowDefinition Height="25"/>
            <!-- Pasek na dole -->
        </Grid.RowDefinitions>

        <!-- 1. MENU GÓRNE -->
        <Menu Grid.Row="0" Background="#E5E5E5" Padding="3">
            <MenuItem Header="Zlecenie"/>
            <MenuItem Header="Pozycja"/>
            <MenuItem Header="Ceny"/>
            <MenuItem Header="Klienci"/>
            <MenuItem Header="Widok"/>
            <MenuItem Header="Konfiguracja menu"/>
        </Menu>

        <!-- 2. PASEK NARZĘDZI -->
        <ToolBar Grid.Row="1" Background="#E5E5E5" Padding="2" Height="40">

            <!-- GRUPA 1: Zapis i wyjście -->
            <Button Click="BtnZamknijZapisz_Click" ToolTip="Zamknij i zapisz" Margin="2" Background="LightBlue">
                <Image Source="Ikony/1.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnWyjdzBezZapisu_Click" ToolTip="Wyjdź bez zapisu" Margin="2" Background="LightCoral">
                <Image Source="Ikony/2.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnZapiszPostepy_Click" ToolTip="Zapisz postępy" Margin="2">
                <Image Source="Ikony/3.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnDrukuj_Click" ToolTip="Drukuj ofertę" Margin="2">
                <Image Source="Ikony/4.png" Width="24" Height="24" />
            </Button>

            <Separator Margin="5,0"/>

            <!-- GRUPA 2: Klienci i Ceny -->
            <Button Click="BtnDodajKlienta_Click" ToolTip="Dodaj klienta z plusem" Margin="2">
                <Image Source="Ikony/5.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnListaKlientow_Click" ToolTip="Lista klientów handlowca" Margin="2">
                <Image Source="Ikony/6.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnAktualizujCeny_Click" ToolTip="Aktualizacja cen w ofercie" Margin="2">
                <Image Source="Ikony/7.png" Width="24" Height="24" />
            </Button>

            <Separator Margin="5,0"/>

            <!-- GRUPA 3: Operacje na pozycjach -->
            <Button Click="BtnPodgladPozycji_Click" ToolTip="Szczegóły / Podgląd pozycji" Margin="2">
                <Image Source="Ikony/8.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnNowaPozycja_Click" ToolTip="Dodaj nową pozycję" Margin="2">
                <Image Source="Ikony/9.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnKopiujPozycje_Click" ToolTip="Kopiuj zaznaczoną pozycję" Margin="2">
                <Image Source="Ikony/10.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnWstawSpecjalne_Click" ToolTip="Wstawienie (kratka)" Margin="2">
                <Image Source="Ikony/11.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnUsunPozycje_Click" ToolTip="Usuń pozycję (z potwierdzeniem)" Margin="2">
                <Image Source="Ikony/12.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnKopiujZInnego_Click" ToolTip="Kopiuj okno z innego zlecenia" Margin="2">
                <Image Source="Ikony/13.png" Width="24" Height="24" />
            </Button>

            <Separator Margin="5,0"/>

            <!-- GRUPA 4: Sortowanie i odświeżanie -->
            <Button Click="BtnPrzesunNaGore_Click" ToolTip="Przesuń na samą górę" Margin="2">
                <Image Source="Ikony/14.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnPrzesunWGore_Click" ToolTip="Przesuń o 1 w górę" Margin="2">
                <Image Source="Ikony/15.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnPrzesunWDol_Click" ToolTip="Przesuń o 1 w dół" Margin="2">
                <Image Source="Ikony/16.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnPrzesunNaDol_Click" ToolTip="Przesuń na sam dół" Margin="2">
                <Image Source="Ikony/17.png" Width="24" Height="24" />
            </Button>
            <Button Click="BtnOdswiezPozycje_Click" ToolTip="Odśwież pozycję" Margin="2">
                <Image Source="Ikony/18.png" Width="24" Height="24" />
            </Button>

            <Separator Margin="5,0"/>

            <!-- GRUPA 5: Walidacja -->
            <Button Click="BtnBledy_Click" ToolTip="Błędy i Ograniczenia" Margin="2">
                <Image Source="Ikony/wykrzykniki.png" Width="24" Height="24" />
            </Button>

        </ToolBar>

        <!-- 3. NAGŁÓWEK ZLECENIA -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Background="#F5F5F5" Padding="5,10,5,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Zlecenie" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="45726" Background="#EAEAEA" IsReadOnly="True" Margin="2" Padding="2"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Klient" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="50" Text="1025" Margin="2" Padding="2"/>
                    <TextBox Width="150" Text="Nowak Mateusz" Margin="2" Padding="2"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Preferow. termin" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <DatePicker Grid.Row="0" Grid.Column="5" Text="29.06.2026" Margin="2"/>

                <TextBlock Grid.Row="0" Grid.Column="6" Text="Data wpr." VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox Grid.Row="0" Grid.Column="7" Text="15.04.2026" Background="#EAEAEA" IsReadOnly="True" Margin="2" Padding="2"/>

                <TextBlock Grid.Row="0" Grid.Column="8" Text="Transport" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Grid.Row="0" Grid.Column="9" SelectedIndex="0" Margin="2">
                    <ComboBoxItem Content="TAK"/>
                </ComboBox>

                <!-- Drugi wiersz nagłówka -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Wprowadził" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="J.KOWALSKI" Background="#EAEAEA" IsReadOnly="True" Margin="2" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Obszar" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="30" Text="1" Margin="2" Padding="2"/>
                    <TextBox Width="170" Text="Polska" Margin="2" Padding="2"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Typ zlecenia" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="5" SelectedIndex="0" Margin="2">
                    <ComboBoxItem Content="N - priorytet normalny"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="6" Text="Ref." VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="7" Margin="2" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="8" Text="Montaż" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="9" SelectedIndex="0" Margin="2">
                    <ComboBoxItem Content="TAK"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 4. GŁÓWNA ZAWARTOŚĆ -->
        <Grid Grid.Row="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <!-- Konfigurator -->
                <ColumnDefinition Width="*"/>
                <!-- Rysunek -->
                <ColumnDefinition Width="350"/>
                <!-- Prawa strona -->
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA: Konfigurator -->
            <Border Grid.Column="0" BorderBrush="#999999" BorderThickness="1" Background="White" Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Pasek nagłówkowy tabeli -->
                        <Grid Background="#E0E0E0" Height="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Atrybut" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0"/>
                            <TextBlock Grid.Column="1" Text="Wartość" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0"/>
                            <TextBlock Grid.Column="2" Text="Oznaczenie" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Sekcja Domyślne -->
                        <Expander IsExpanded="True" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                            <Expander.Header>
                                <TextBlock Text="Domyślne" FontWeight="Bold" Background="#FFF59D" Width="300" Padding="5,2"/>
                            </Expander.Header>
                            <StackPanel>
                                <!-- Wiersz -->
                                <Grid Height="22" Background="#FAFAFA">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="System okna" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="1" Text="Schuco" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="2" Text="Dostawca profili" VerticalAlignment="Center" Margin="5,0"/>
                                </Grid>
                                <!-- Wiersz -->
                                <Grid Height="22" Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Szerokość" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="1" Text="1000" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="5,0"/>
                                </Grid>
                                <!-- Dodaj tu resztę wierszy w ten sam sposób -->
                            </StackPanel>
                        </Expander>

                        <!-- Sekcja Kolory -->
                        <Expander IsExpanded="True" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                            <Expander.Header>
                                <TextBlock Text="Kolory" FontWeight="Bold" Background="#FFF59D" Width="300" Padding="5,2"/>
                            </Expander.Header>
                            <StackPanel>
                                <Grid Height="22" Background="#FAFAFA">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kolor" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="1" Text="W-W" VerticalAlignment="Center" Margin="5,0"/>
                                    <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
                                    <TextBlock Grid.Column="2" Text="Biały / Biały" VerticalAlignment="Center" Margin="5,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ŚRODEK: Wizualizacja -->
            <Grid Grid.Column="1" Margin="5,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#999999" BorderThickness="1" Background="White">
                    <TextBlock Text="[ TU POJAWI SIĘ RYSUNEK OKNA ]" FontSize="18" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Row="1" Margin="0,5">
                    <TextBlock Text="✔️" Foreground="Green" FontWeight="Bold" HorizontalAlignment="Left" FontSize="16"/>
                    <TextBlock Text="Widok od wewnątrz" HorizontalAlignment="Right" Foreground="#555555"/>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#999999" BorderThickness="1" Background="White" Padding="10">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Jednostka" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nr prod."/>
                                <TextBlock Grid.Column="1" Text="F100    Okno 1 kw."/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Typ produktu"/>
                                <TextBlock Grid.Column="1" Text="Schuco Focusing MD"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Wymiary ościeżnicy"/>
                                <TextBlock Grid.Column="1" Text="1000 x 1000"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- PRAWA KOLUMNA -->
            <Grid Grid.Column="2" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Pozycji -->
                <DataGrid x:Name="GridPozycje" Grid.Row="0" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="All" Background="White" BorderBrush="#999999" AlternatingRowBackground="#F9F9F9" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Poz." Width="40" Binding="{Binding Poz}"/>
                        <DataGridTextColumn Header="Nr prod." Width="60" Binding="{Binding NrProd}"/>
                        <DataGridTextColumn Header="Szt." Width="40" Binding="{Binding Szt}"/>
                        <DataGridTextColumn Header="Rodzaj" Width="50" Binding="{Binding Rodzaj}"/>
                        <DataGridTextColumn Header="Oznaczenie" Width="*" Binding="{Binding Oznaczenie}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Sumy -->
                <Border Grid.Row="1" Background="#E5E5E5" BorderBrush="#999999" BorderThickness="1" Margin="0,10,0,10">
                    <StackPanel>
                        <Border Background="#D0D0D0" BorderBrush="#999999" BorderThickness="0,0,0,1">
                            <TextBlock Text="Sumy" HorizontalAlignment="Center" Padding="2"/>
                        </Border>
                        <StackPanel Margin="5">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cena całkowita pozycji"/>
                                <TextBlock Grid.Column="1" Text="3 600,00 PLN"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cena całkowita wszystkich pozycji"/>
                                <TextBlock Grid.Column="1" Text="12 100,00 PLN"/>
                            </Grid>
                            <Separator Margin="0,5"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cena montażu"/>
                                <TextBlock Grid.Column="1" Text="3 800,00 PLN"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Całkowity koszt"/>
                                <TextBlock Grid.Column="1" Text="14 898,00 PLN" FontWeight="Bold" Foreground="#D32F2F"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Przyciski -->
                <UniformGrid Grid.Row="2" Columns="4" Height="30" Margin="0,0,0,5">
                    <Button Content="Uwagi do poz." Margin="2" Background="#FAFAFA"/>
                    <Button Content="Szczegóły" Margin="2" Background="#FAFAFA"/>
                    <Button Content="Spec. mat." Margin="2" Background="#FAFAFA"/>
                    <Button Content="Korekta ceny" Margin="2" Background="#FAFAFA"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- 5. PASEK STANU -->
        <StatusBar Grid.Row="4" Background="#E5E5E5">
            <StatusBarItem>
                <TextBlock Text="15.04.2026"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="J.KOWALSKI" Margin="0,0,20,0"/>
                    <TextBlock Text="12:34"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
    