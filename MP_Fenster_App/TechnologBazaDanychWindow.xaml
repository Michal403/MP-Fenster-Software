<Window x:Class="MP_Fenster_App.TechnologBazaDanychWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="FENSTER 1.0 - Słowniki techniczne" Height="650" Width="1050"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tabela techniczna" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox x:Name="CmbTabele" Grid.Column="1" Height="28" DisplayMemberPath="Label" SelectedValuePath="Name" SelectionChanged="CmbTabele_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="Technolog może uzupełniać rekordy słowników konfiguratora, ale nie zmienia struktury bazy." VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#666666"/>
            </Grid>
        </Border>

        <DataGrid x:Name="DgTabela" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All" Background="White" BorderBrush="#CCCCCC"
                  AlternatingRowBackground="#FAFAFA" RowHeaderWidth="30"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odśwież" Width="110" Height="30" Margin="5,0" Click="BtnOdswiez_Click"/>
            <Button Content="Zapisz zmiany" Width="130" Height="30" Margin="5,0" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="BtnZapisz_Click"/>
            <Button Content="Zamknij" Width="100" Height="30" Margin="5,0" Background="#E74C3C" Foreground="White" Click="BtnZamknij_Click"/>
        </StackPanel>
    </Grid>
</Window>

