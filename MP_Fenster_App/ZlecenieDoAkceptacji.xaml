<Window x:Class="MP_Fenster_App.ZlecenieDoAkceptacji"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="Weryfikacja Technologiczna Konstrukcji" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Wykryto przekroczenie gabarytów technicznych!" 
                       FontSize="14" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Wpisz uzasadnienie / warunki akceptacji błędu:" 
                   FontWeight="SemiBold" Margin="0,5,0,5" FontSize="11"/>

        <TextBox x:Name="TxtKomentarzTechnologa" Grid.Row="2" 
                 TextWrapping="Wrap" AcceptsReturn="True" 
                 Padding="5" Background="White" BorderBrush="#CCCCCC"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Anuluj" Width="100" Height="30" Margin="0,0,10,0"
                    Click="BtnAnuluj_Click" Background="#E0E0E0" BorderThickness="0"/>

            <Button Content="Zatwierdź odstępstwo" Width="150" Height="30" 
                    Click="BtnZatwierdz_Click" Background="#4CAF50" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
