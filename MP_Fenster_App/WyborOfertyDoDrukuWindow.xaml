<Window x:Class="MP_Fenster_App.WyborOfertyDoDrukuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FENSTER 1.0 - Drukowanie oferty" Height="580" Width="980"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        Icon="/Ikony/logo.png">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="WYBÓR DOKUMENTU DO WYDRUKU" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="TxtOpis" Text="Wybierz ofertę albo zlecenie i wygeneruj profesjonalny wydruk HTML." Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Szukaj" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSzukaj" Grid.Column="1" Height="24" TextChanged="TxtSzukaj_TextChanged"/>
                <Button Grid.Column="2" Content="Odśwież" Width="90" Height="26" Margin="8,0,0,0" Click="BtnOdswiez_Click"/>
                <TextBlock x:Name="TxtZakres" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666666"/>
            </Grid>
        </Border>

        <DataGrid x:Name="DgDokumenty" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" Background="White"
                  AlternatingRowBackground="#FAFAFA" BorderBrush="#CCCCCC" RowHeaderWidth="0"
                  SelectionMode="Single" MouseDoubleClick="DgDokumenty_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="55" Binding="{Binding IdZlecenia}"/>
                <DataGridTextColumn Header="Numer" Width="90" Binding="{Binding NumerZlecenia}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Klient" Width="230" Binding="{Binding NazwaKlienta}"/>
                <DataGridTextColumn Header="Handlowiec" Width="120" Binding="{Binding Wprowadzil}"/>
                <DataGridTextColumn Header="Data" Width="135" Binding="{Binding DataWprowadzenia, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
                <DataGridTextColumn Header="Dokument" Width="95" Binding="{Binding StatusZlecenia}"/>
                <DataGridTextColumn Header="Techniczne" Width="165" Binding="{Binding StatusTechniczny}"/>
                <DataGridTextColumn Header="Produkcja" Width="*" Binding="{Binding StatusProdukcji}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Generuj wydruk" Width="150" Height="32" Margin="5,0" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="BtnDrukuj_Click"/>
            <Button Content="Zamknij" Width="100" Height="32" Margin="5,0" Background="#E74C3C" Foreground="White" Click="BtnZamknij_Click"/>
        </StackPanel>
    </Grid>
</Window>
