<Window x:Class="MP_Fenster_App.BledyOgraniczenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="Błędy i ograniczenia" Height="360" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtStatus" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtKomentarz" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnAkceptuj" Content="Zatwierdź odstępstwo" Width="150" Margin="0,0,6,0" Click="BtnAkceptuj_Click"/>
            <Button Content="Zamknij" Width="100" Click="BtnZamknij_Click"/>
        </StackPanel>
    </Grid>
</Window>
