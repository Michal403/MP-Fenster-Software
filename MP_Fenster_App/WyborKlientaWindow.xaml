<Window x:Class="MP_Fenster_App.WyborKlientaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Ikony/logo.png"
        Title="Wybór klienta" Height="520" Width="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSzukaj" Width="260" TextChanged="TxtSzukaj_TextChanged"/>
        </StackPanel>
        <DataGrid x:Name="DgKlienci" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  MouseDoubleClick="DgKlienci_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdKlienta}" Width="60"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding NazwaKlienta}" Width="220"/>
                <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" Width="120"/>
                <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="*"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Wybierz" Width="100" Margin="0,0,6,0" Click="BtnWybierz_Click"/>
            <Button Content="Anuluj" Width="100" Click="BtnAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
